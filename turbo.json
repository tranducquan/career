{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"dev": { "cache": false, "persistent": true },
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"],
			"env": ["ADMIN_PASSWORD", "ADMIN_SESSION_SECRET", "DATABASE_URL"]
		},
		"lint": {}
	}
}
